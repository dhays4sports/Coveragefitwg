{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "coveragefit",
  "pages_build_output_dir": ".",
  "compatibility_date": "2026-08-02",
  "vars": {
    "COVERAGEFIT_NEW_REVIEW_NOTIFICATIONS_ENABLED": "true",
    "COVERAGEFIT_PRODUCER_NOTIFICATION_EMAIL": "producer@example.com",
    "COVERAGEFIT_NOTIFICATION_FROM": "CoverageFit <reviews@example.com>",
    "RCSMS_PRODUCER_ALERTS_ENABLED": "true",
    "RINGCENTRAL_SERVER_URL": "https://platform.ringcentral.com",
    "RINGCENTRAL_CLIENT_ID": "REPLACE_WITH_PRIVATE_APP_CLIENT_ID",
    "RINGCENTRAL_FROM_NUMBER": "+14085550123",
    "RINGCENTRAL_WEBHOOK_URL": "https://coveragefit.com/api/sms/ringcentral/webhook",
    "RINGCENTRAL_ACCOUNT_ID": "~",
    "RINGCENTRAL_EXTENSION_ID": "~",
    "RINGCENTRAL_SUBSCRIPTION_EXPIRES_IN": "3600",
    "COVERAGEFIT_DISCOVERY_MONTHLY_REQUEST_LIMIT": "900",
    "COVERAGEFIT_DISCOVERY_RESULT_LIMIT": "8",
    "COVERAGEFIT_DISCOVERY_QUERIES_PER_SWEEP": "8"
  },
  "d1_databases": [
    {
      "binding": "COVERAGEFIT_DB",
      "database_name": "coveragefit-production",
      "database_id": "REPLACE_WITH_PRODUCTION_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "POLICY_FILES",
      "bucket_name": "coveragefit-policy-files-production"
    }
  ],
  "secrets": {
    "required": ["COVERAGEFIT_PRODUCER_ACCESS_TOKEN", "RESEND_API_KEY", "RINGCENTRAL_CLIENT_SECRET", "RINGCENTRAL_JWT_TOKEN", "RINGCENTRAL_WEBHOOK_VALIDATION_TOKEN", "RINGCENTRAL_CONVERSATION_HASH_SECRET", "BRAVE_SEARCH_API_KEY"]
  },
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "COVERAGEFIT_DB",
          "database_name": "coveragefit-preview",
          "database_id": "REPLACE_WITH_PREVIEW_D1_DATABASE_ID",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "POLICY_FILES",
          "bucket_name": "coveragefit-policy-files-preview"
        }
      ],
      "secrets": {
        "required": ["COVERAGEFIT_PRODUCER_ACCESS_TOKEN", "RESEND_API_KEY", "RINGCENTRAL_CLIENT_SECRET", "RINGCENTRAL_JWT_TOKEN", "RINGCENTRAL_WEBHOOK_VALIDATION_TOKEN", "RINGCENTRAL_CONVERSATION_HASH_SECRET", "BRAVE_SEARCH_API_KEY"]
      }
    }
  }
}
